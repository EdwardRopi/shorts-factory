# Локальная модель через Ollama — используется по умолчанию, ключей не требует
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=mistral

# Облачный Mistral — понадобится на проде, локально можно не заполнять
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Ключи видеостоков — понадобятся на шаге 2
PEXELS_API_KEY=
PIXABAY_API_KEY=
